# Copy these values to your local environment. Never commit real secrets.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Optional locally; when set, use a PostgreSQL connection URL.
DATABASE_URL=
# Optional locally; configure all four values to use Cloudflare R2.
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
